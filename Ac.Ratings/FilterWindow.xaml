<controls:ModernWindowBase
    x:Class="Ac.Ratings.FilterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Ac.Ratings.Theme.ModernUI.Controls"
    xmlns:converters="clr-namespace:Ac.Ratings.Theme.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ac.Ratings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="FilterWindow"
    Width="1280"
    Height="720"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <controls:ModernWindowBase.Resources>
        <converters:DoubleToStringConverter x:Key="DoubleToStringConverter" />
    </controls:ModernWindowBase.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Authors (Left)  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,5,0">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="Authors" />
            <DataGrid
                Name="FilterDatagrid"
                Height="300"
                Margin="0,5,0,0"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                ItemsSource="{Binding AvailableAuthors}">
                <DataGrid.Columns>
                    <controls:DataGridTextColumn
                        Width="*"
                        Binding="{Binding Name}"
                        Header="Author"
                        IsReadOnly="True" />
                    <controls:DataGridCheckBoxColumn
                        Width="100"
                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                        Header="Selected" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!--  Classes (Right)  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Margin="5,0,5,0">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="Classes" />
            <DataGrid
                Name="ClassesDatagrid"
                Height="300"
                Margin="0,5,0,0"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                ItemsSource="{Binding AvailableClasses}">
                <DataGrid.Columns>
                    <controls:DataGridTextColumn
                        Width="*"
                        Binding="{Binding Name}"
                        Header="Class"
                        IsReadOnly="True" />
                    <controls:DataGridCheckBoxColumn
                        Width="100"
                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                        Header="Selected" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <StackPanel
            Grid.Row="0"
            Grid.Column="2"
            Margin="5,0,0,0">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="Minimum Ratings" />
            <ListView Margin="0,5,0,0" ItemsSource="{Binding RatingFilters}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                TextTrimming="CharacterEllipsis">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}: {1}">
                                        <Binding Path="DisplayName" />
                                        <Binding Path="MinValue" Converter="{StaticResource DoubleToStringConverter}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Slider
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="10"
                                Minimum="0"
                                TickFrequency="1"
                                Value="{Binding MinValue, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!--  Gearbox and Drivetrain (Below, Side by Side)  -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,10,5,0">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="Gearbox" />
            <ComboBox
                Margin="0,5,0,0"
                ItemsSource="{Binding GearboxOptions}"
                SelectedItem="{Binding GearboxFilter, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Margin="5,10,0,0">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="Drivetrain" />
            <ComboBox
                Margin="0,5,0,0"
                ItemsSource="{Binding DrivetrainOptions}"
                SelectedItem="{Binding DrivetrainFilter, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!--  Buttons (Centered Below)  -->
        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,10,0"
                Command="{Binding ResetFiltersCommand}"
                Content="Reset" />
            <Button Command="{Binding ApplyFiltersCommand}" Content="Apply" />
        </StackPanel>
    </Grid>
</controls:ModernWindowBase>
