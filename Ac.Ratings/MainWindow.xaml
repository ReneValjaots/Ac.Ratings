<controls:ModernWindowBase
    x:Class="Ac.Ratings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Ac.Ratings.Theme.Components"
    xmlns:controls="clr-namespace:Ac.Ratings.Theme.ModernUI.Controls"
    xmlns:controls1="clr-namespace:Ac.Ratings.Theme.Controls"
    xmlns:converters="clr-namespace:Ac.Ratings.Theme.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Ac.Ratings.Theme.ModernUI.Helpers"
    xmlns:local="clr-namespace:Ac.Ratings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Ac.Ratings.Model"
    Title="Ratings App"
    Width="1900"
    Height="1000"
    Closing="Window_Closing"
    ContentSource="/Theme/Components/Home.xaml"
    Icon="Images/rating.ico"
    IsTitleVisible="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <controls:ModernWindowBase.MenuLinkGroups>
        <helpers:LinkGroup DisplayName="Home" Source="/Theme/Components/Home.xaml" IsNavigable="True" />
        <helpers:LinkGroup DisplayName="Filter Cars" Source="/Theme/Components/Filter.xaml" IsNavigable="True" />
        <helpers:LinkGroup DisplayName="Settings" Source="/Theme/Components/Settings.xaml" IsNavigable="True" />
    </controls:ModernWindowBase.MenuLinkGroups>
</controls:ModernWindowBase>
