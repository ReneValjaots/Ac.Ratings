<controls:ModernWindowBase
    x:Class="Ac.Ratings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Ac.Ratings.Theme.ModernUI.Controls"
    xmlns:converters="clr-namespace:Ac.Ratings.Theme.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Ac.Ratings.Theme.ModernUI.Helpers"
    xmlns:local="clr-namespace:Ac.Ratings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Ac.Ratings.Model"
    Title="Ratings App"
    Width="1900"
    Height="1000"
    Closing="Window_Closing"
    Icon="Images/rating.ico"
    IsTitleVisible="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <controls:ModernWindowBase.Resources>
        <converters:SubtractConverter x:Key="SubtractConverter" />
    </controls:ModernWindowBase.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <TextBox
            Name="SearchBox"
            Width="{Binding ElementName=CarList, Path=ActualWidth, Converter={StaticResource SubtractConverter}, ConverterParameter=20}"
            MinWidth="150"
            Style="{StaticResource PrimaryTextBox}"
            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Margin="5"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <Button
                Margin="0,0,5,0"
                Command="{Binding OpenFilterCommand}"
                Content="Filter" />
            <Button
                Margin="0,0,5,0"
                Command="{Binding ResetFiltersCommand}"
                Content="Reset Filters" />
        </StackPanel>

        <ListView
            x:Name="CarList"
            Grid.Row="1"
            Grid.Column="0"
            MinWidth="200"
            Margin="0,0,10,0"
            HorizontalAlignment="Left"
            Background="Transparent"
            ItemsSource="{Binding CarView}"
            SelectedItem="{Binding SelectedCar}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>


        <StackPanel
            Grid.Row="0"
            Grid.Column="2"
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <Button
                x:Name="SettingsButton"
                Click="SettingsButton_OnClick"
                Content="Settings" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ItemsControl
                    Grid.Row="0"
                    Margin="0,10,0,0"
                    ItemsSource="{Binding SkinPreviews}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.SelectSkinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding PreviewPath}">
                                <Image
                                    Width="35"
                                    Height="35"
                                    Margin="1"
                                    Source="{Binding LiveryImage}"
                                    Stretch="UniformToFill" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Grid.Row="1"
                    Height="Auto"
                    Margin="0,10,0,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Text="{Binding SelectedCar.Name, Mode=TwoWay}" />

                <Image
                    x:Name="CarImage"
                    Grid.Row="2"
                    MaxWidth="800"
                    MaxHeight="445"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Source="{Binding CarImageSource}" />
            </Grid>

            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="9*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="Power"
                            Grid.Column="0"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="{Binding SelectedCar.Specs.Bhp}"
                            TextAlignment="Center" />
                    </Grid>

                    <TextBlock
                        FontSize="10"
                        Text="Total Power Output"
                        TextAlignment="Center" />
                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Center">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Text="{Binding SelectedCar.Specs.Torque}"
                        TextAlignment="Center" />
                    <TextBlock
                        FontSize="10"
                        Text="Torque"
                        TextAlignment="Center" />
                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalAlignment="Center">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Text="{Binding SelectedCar.Specs.Acceleration}"
                        TextAlignment="Center" />
                    <TextBlock
                        FontSize="10"
                        Text="0 to 100 km/h"
                        TextAlignment="Center" />
                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="3"
                    HorizontalAlignment="Center">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Text="{Binding SelectedCar.Specs.TopSpeed}"
                        TextAlignment="Center" />
                    <TextBlock
                        FontSize="10"
                        Text="Top Speed"
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock
                        x:Name="Engine"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="{Binding EngineStats}"
                        TextAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock
                        x:Name="Gearbox"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="{Binding GearboxStats}"
                        TextAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock
                        x:Name="Drivetrain"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="{Binding DrivetrainStats}"
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid DataContext="{Binding SelectedCar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom">
                    <TextBlock Text="Brand:" />
                    <TextBlock Text="Year:" />
                    <TextBlock Text="Class:" />
                    <TextBlock Text="Author:" />
                    <TextBlock Text="Weight:" />
                    <TextBlock Text="Power-to-weight ratio:" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Brand, Mode=TwoWay}" />
                    <TextBlock Text="{Binding Year, Mode=TwoWay}" />
                    <TextBlock Text="{Binding Class, Mode=TwoWay}" />
                    <TextBlock Text="{Binding Author, Mode=TwoWay}" />
                    <TextBlock Text="{Binding Specs.Weight}" />
                    <TextBlock Text="{Binding Specs.PowerToWeightRatio}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="2"
            Margin="0,0,10,0"
            VerticalAlignment="Top"
            DataContext="{Binding SelectedCar}">

            <!--  Corner Handling  -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="{Binding Path=Ratings.CornerHandling, StringFormat='Corner Handling: {0}'}" />

                <Slider
                    x:Name="CornerHandlingSlider"
                    Grid.Column="1"
                    Width="150"
                    Style="{StaticResource PrimarySlider}"
                    Value="{Binding Path=Ratings.CornerHandling, Mode=TwoWay}" />
            </Grid>


            <!--  Braking  -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="{Binding Path=Ratings.Brakes, StringFormat='Braking: {0}'}" />
                <Slider
                    x:Name="BrakesSlider"
                    Grid.Column="1"
                    Width="150"
                    Style="{StaticResource PrimarySlider}"
                    Value="{Binding Path=Ratings.Brakes, Mode=TwoWay}" />
            </Grid>

            <!--  Realism  -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="{Binding Path=Ratings.Realism, StringFormat='Realism: {0}'}" />
                <Slider
                    x:Name="RealismSlider"
                    Grid.Column="1"
                    Width="150"
                    Style="{StaticResource PrimarySlider}"
                    Value="{Binding Path=Ratings.Realism, Mode=TwoWay}" />
            </Grid>

            <!--  Sound  -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="{Binding Path=Ratings.Sound, StringFormat='Sound: {0}'}" />
                <Slider
                    x:Name="SoundSlider"
                    Grid.Column="1"
                    Width="150"
                    Style="{StaticResource PrimarySlider}"
                    Value="{Binding Path=Ratings.Sound, Mode=TwoWay}" />
            </Grid>

            <!--  Exterior Quality  -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="{Binding Path=Ratings.ExteriorQuality, StringFormat='Exterior Quality: {0}'}" />
                <Slider
                    x:Name="ExteriorQualitySlider"
                    Grid.Column="1"
                    Width="150"
                    Style="{StaticResource PrimarySlider}"
                    Value="{Binding Path=Ratings.ExteriorQuality, Mode=TwoWay}" />
            </Grid>

            <!--  Interior Quality  -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="{Binding Path=Ratings.InteriorQuality, StringFormat='Interior Quality: {0}'}" />
                <Slider
                    x:Name="InteriorQualitySlider"
                    Grid.Column="1"
                    Width="150"
                    Style="{StaticResource PrimarySlider}"
                    Value="{Binding Path=Ratings.InteriorQuality, Mode=TwoWay}" />
            </Grid>

            <!--  Force Feedback Quality  -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="{Binding Path=Ratings.ForceFeedbackQuality, StringFormat='FFB Quality: {0}'}" />
                <Slider
                    x:Name="ForceFeedbackQualitySlider"
                    Grid.Column="1"
                    Width="150"
                    Style="{StaticResource PrimarySlider}"
                    Value="{Binding Path=Ratings.ForceFeedbackQuality, Mode=TwoWay}" />
            </Grid>

            <!--  Fun Factor  -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="{Binding Path=Ratings.FunFactor, StringFormat='Fun Factor: {0}'}" />
                <Slider
                    x:Name="FunFactorSlider"
                    Grid.Column="1"
                    Width="150"
                    Style="{StaticResource PrimarySlider}"
                    Value="{Binding Path=Ratings.FunFactor, Mode=TwoWay}" />
            </Grid>

            <!--  Average Rating  -->
            <TextBlock
                x:Name="AverageRatingTextBlock"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Text="{Binding Ratings.AverageRating, StringFormat='Average Rating: {0:F2}'}" />

            <StackPanel
                x:Name="ExtraFeatures"
                Margin="10"
                Orientation="Vertical">
                <!--  Section Header  -->
                <TextBlock
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Extra Features" />

                <!--  Dashboard Lights Section  -->
                <TextBlock
                    Margin="0,5"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Dashboard Lights:" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Row 1  -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Turn Signals" />
                    <CheckBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        IsChecked="{Binding Ratings.TurnSignalsDashboard, Mode=TwoWay}" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="ABS On (Flashing)" />
                    <CheckBox
                        Grid.Row="0"
                        Grid.Column="3"
                        Margin="5"
                        IsChecked="{Binding Ratings.AbsOnFlashing, Mode=TwoWay}" />

                    <!--  Row 2  -->
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="TC On (Flashing)" />
                    <CheckBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5"
                        IsChecked="{Binding Ratings.TcOnFlashing, Mode=TwoWay}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="ABS Off" />
                    <CheckBox
                        Grid.Row="1"
                        Grid.Column="3"
                        Margin="5"
                        IsChecked="{Binding Ratings.AbsOff, Mode=TwoWay}" />

                    <!--  Row 3  -->
                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="TC Off" />
                    <CheckBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="5"
                        IsChecked="{Binding Ratings.TcOff, Mode=TwoWay}" />
                    <Label
                        Grid.Row="2"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Handbrake" />
                    <CheckBox
                        Grid.Row="2"
                        Grid.Column="3"
                        Margin="5"
                        IsChecked="{Binding Ratings.Handbrake, Mode=TwoWay}" />

                    <!--  Row 4  -->
                    <Label
                        Grid.Row="3"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Lights" />
                    <CheckBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="5"
                        IsChecked="{Binding Ratings.LightsDashboard, Mode=TwoWay}" />
                    <Label
                        Grid.Row="3"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Other" />
                    <CheckBox
                        Grid.Row="3"
                        Grid.Column="3"
                        Margin="5"
                        IsChecked="{Binding Ratings.OtherDashboard, Mode=TwoWay}" />
                </Grid>

                <!--  Outer Lights Section  -->
                <TextBlock
                    Margin="0,5"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Exterior:" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Row 1  -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Turn Signals" />
                    <CheckBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        IsChecked="{Binding Ratings.TurnSignalsExterior, Mode=TwoWay}" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Good Quality Lights" />
                    <CheckBox
                        Grid.Row="0"
                        Grid.Column="3"
                        Margin="5"
                        IsChecked="{Binding Ratings.GoodQualityLights, Mode=TwoWay}" />

                    <!--  Row 2  -->
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Emergency Brake Lights" />
                    <CheckBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5"
                        IsChecked="{Binding Ratings.EmergencyBrakeLights, Mode=TwoWay}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Fog Lights" />
                    <CheckBox
                        Grid.Row="1"
                        Grid.Column="3"
                        Margin="5"
                        IsChecked="{Binding Ratings.FogLights, Mode=TwoWay}" />

                    <!--  Row 3  -->
                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Sequential Turn Signals" />
                    <CheckBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="5"
                        IsChecked="{Binding Ratings.SequentialTurnSignals, Mode=TwoWay}" />
                    <Label
                        Grid.Row="2"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Animations" />
                    <CheckBox
                        Grid.Row="2"
                        Grid.Column="3"
                        Margin="5"
                        IsChecked="{Binding Ratings.Animations, Mode=TwoWay}" />
                </Grid>

                <!--  Others Section  -->
                <TextBlock
                    Margin="0,5"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Others:" />
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Extended Physics" />
                    <CheckBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        IsChecked="{Binding Ratings.ExtendedPhysics, Mode=TwoWay}" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Startup Sound" />
                    <CheckBox
                        Grid.Row="0"
                        Grid.Column="3"
                        Margin="5"
                        IsChecked="{Binding Ratings.StartupSound, Mode=TwoWay}" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Different Displays" />
                    <CheckBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5"
                        IsChecked="{Binding Ratings.DifferentDisplays, Mode=TwoWay}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Different Driving Modes" />
                    <CheckBox
                        Grid.Row="1"
                        Grid.Column="3"
                        Margin="5"
                        IsChecked="{Binding Ratings.DifferentDrivingModes, Mode=TwoWay}" />
                </Grid>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="ClearRatingsButton"
                    Grid.Column="0"
                    Margin="10"
                    Command="{Binding DataContext.ClearRatingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="Clear Ratings" />

                <Button
                    x:Name="ClearFeaturesButton"
                    Grid.Column="1"
                    Margin="10"
                    Command="{Binding DataContext.ClearExtraFeaturesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="Clear Extra Features" />
            </Grid>
        </StackPanel>
    </Grid>
</controls:ModernWindowBase>
