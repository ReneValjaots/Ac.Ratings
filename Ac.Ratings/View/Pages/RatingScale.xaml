<UserControl x:Class="Ac.Ratings.View.Pages.RatingScale"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ac.Ratings.View.Pages"
             xmlns:converters="clr-namespace:Ac.Ratings.Theme.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </UserControl.Resources>
    <Grid>
        <ScrollViewer>
            <StackPanel MinWidth="150" Margin="16">
                <TextBlock Text="RATING SCALE" Style="{StaticResource Heading2}" Margin="0,0,0,8" FontWeight="Bold" FontSize="16"/>

                <!-- Rating Scale Selection -->
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Rating Scale Maximum:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableRatingScales}"
                              SelectedItem="{Binding SelectedRatingScale, Mode=TwoWay}"
                              HorizontalAlignment="Left"
                              MinWidth="80"/>
                </Grid>

                <!-- Rebase Rounding Mode Selection -->
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Rounding Mode (when reducing scale):" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding RoundingModes}"
                              SelectedItem="{Binding SelectedRoundingMode, Mode=TwoWay}"
                              HorizontalAlignment="Left"
                              MinWidth="120">
                        <ComboBox.ItemTemplate>
                            <!-- Use ItemTemplate to customize display -->
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <TextBlock TextWrapping="Wrap" FontStyle="Italic" Margin="0,5,0,15" FontSize="12">
                    Select the maximum value for ratings (5 or 10). If you decrease the scale (e.g., from 10 to 5), existing ratings will be scaled down. Choose how fractional results (like 2.5) should be rounded. Changes require saving.
                </TextBlock>

                <!-- Save Button -->
                <Button Content="Save Rating Settings"
                        Command="{Binding SaveSettingsCommand}"
                        HorizontalAlignment="Left"
                        Width="160"
                        Margin="0,20,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
