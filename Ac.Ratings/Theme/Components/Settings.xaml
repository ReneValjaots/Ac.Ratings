<UserControl
    x:Class="Ac.Ratings.Theme.Components.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Ac.Ratings.Theme.ModernUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Ac.Ratings.Theme.ModernUI.Helpers"
    xmlns:local="clr-namespace:Ac.Ratings.Theme.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <controls:ModernTab
            ContentLoader="{StaticResource CustomContentLoader}"
            DataContext="{Binding}"
            Layout="List"
            SelectedSource="General.xaml">
            <controls:ModernTab.Links>
                <helpers:Link DisplayName="General" Source="/Theme/Components/General.xaml" />
                <helpers:Link DisplayName="Power Format" Source="/Theme/Components/PowerFormat.xaml" />
                <helpers:Link DisplayName="Root Folder" Source="/Theme/Components/RootFolder.xaml" />
                <helpers:Link DisplayName="Restore Ratings" Source="/Theme/Components/RestoreRatings.xaml" />
                <helpers:Link DisplayName="Appearance" Source="/Theme/Components/Appearance.xaml" />
            </controls:ModernTab.Links>
        </controls:ModernTab>
    </Grid>
</UserControl>
