<UserControl
    x:Class="Ac.Ratings.Theme.Components.Filter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Ac.Ratings.Theme.Controls"
    xmlns:controls1="clr-namespace:Ac.Ratings.Theme.ModernUI.Controls"
    xmlns:converters="clr-namespace:Ac.Ratings.Theme.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ac.Ratings.Theme.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Authors (Left)  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,5,0">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="Authors" />
            <controls:FilterItemList Margin="0,5,0,0" Items="{Binding AvailableAuthors}" />
        </StackPanel>

        <!--  Classes (Right)  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Margin="5,0,5,0">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="Classes" />
            <controls:FilterItemList Margin="0,5,0,0" Items="{Binding AvailableClasses}" />
        </StackPanel>

        <StackPanel
            Grid.Row="0"
            Grid.Column="2"
            Margin="5,0,0,0">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="Minimum Ratings" />
            <controls:RatingSliderControl
                LabelText="Corner Handling"
                SliderStyle="{StaticResource {x:Type Slider}}"
                SliderValue="{Binding MinCornerHandling, Mode=TwoWay}"
                SliderWidth="125" />
            <controls:RatingSliderControl
                LabelText="Braking"
                SliderStyle="{StaticResource {x:Type Slider}}"
                SliderValue="{Binding MinBrakes, Mode=TwoWay}"
                SliderWidth="125" />
            <controls:RatingSliderControl
                LabelText="Realism"
                SliderStyle="{StaticResource {x:Type Slider}}"
                SliderValue="{Binding MinRealism, Mode=TwoWay}"
                SliderWidth="125" />
            <controls:RatingSliderControl
                LabelText="Sound"
                SliderStyle="{StaticResource {x:Type Slider}}"
                SliderValue="{Binding MinSound, Mode=TwoWay}"
                SliderWidth="125" />
            <controls:RatingSliderControl
                LabelText="Exterior Quality"
                SliderStyle="{StaticResource {x:Type Slider}}"
                SliderValue="{Binding MinExteriorQuality, Mode=TwoWay}"
                SliderWidth="125" />
            <controls:RatingSliderControl
                LabelText="Interior Quality"
                SliderStyle="{StaticResource {x:Type Slider}}"
                SliderValue="{Binding MinInteriorQuality, Mode=TwoWay}"
                SliderWidth="125" />
            <controls:RatingSliderControl
                LabelText="FFB Quality"
                SliderStyle="{StaticResource {x:Type Slider}}"
                SliderValue="{Binding MinForceFeedbackQuality, Mode=TwoWay}"
                SliderWidth="125" />
            <controls:RatingSliderControl
                LabelText="Fun Factor"
                SliderStyle="{StaticResource {x:Type Slider}}"
                SliderValue="{Binding MinFunFactor, Mode=TwoWay}"
                SliderWidth="125" />
            <controls:RatingSliderControl
                LabelText="Average Rating"
                SliderStyle="{StaticResource {x:Type Slider}}"
                SliderValue="{Binding MinAverageRating, Mode=TwoWay}"
                SliderWidth="125" />
        </StackPanel>

        <!--  Gearbox and Drivetrain (Below, Side by Side)  -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,10,5,0">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="Gearbox" />
            <ComboBox
                Margin="0,5,0,0"
                ItemsSource="{Binding GearboxOptions}"
                SelectedItem="{Binding GearboxFilter, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Margin="5,10,0,0">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="Drivetrain" />
            <ComboBox
                Margin="0,5,0,0"
                ItemsSource="{Binding DrivetrainOptions}"
                SelectedItem="{Binding DrivetrainFilter, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!--  Buttons (Centered Below)  -->
        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,10,0"
                Command="{Binding ResetFiltersCommand}"
                Content="Reset" />
            <Button Command="{Binding ApplyFiltersCommand}" Content="Apply" />
        </StackPanel>
    </Grid>
</UserControl>
