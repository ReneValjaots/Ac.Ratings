<UserControl
    x:Class="Ac.Ratings.Theme.Controls.CarSpecsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ac.Ratings.Theme.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="0,5,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Text="{Binding SelectedCar.Specs.Bhp}"
                TextAlignment="Center" />
            <TextBlock
                FontSize="10"
                Text="Total Power Output"
                TextAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Text="{Binding SelectedCar.Specs.Torque}"
                TextAlignment="Center" />
            <TextBlock
                FontSize="10"
                Text="Torque"
                TextAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Text="{Binding SelectedCar.Specs.Acceleration}"
                TextAlignment="Center" />
            <TextBlock
                FontSize="10"
                Text="0 to 100 km/h"
                TextAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Text="{Binding SelectedCar.Specs.TopSpeed}"
                TextAlignment="Center" />
            <TextBlock
                FontSize="10"
                Text="Top Speed"
                TextAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
