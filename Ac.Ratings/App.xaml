<Application
    x:Class="Ac.Ratings.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Ac.Ratings"
    xmlns:helpers="clr-namespace:Ac.Ratings.Theme.ModernUI.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/ModernUI/Assets/ModernUI.xaml" />
                <ResourceDictionary Source="/Theme/ModernUI/Assets/ModernUI.Black.xaml" />
                <ResourceDictionary Source="/Theme/ModernUI/Assets/ModernWindow.xaml" />
                <ResourceDictionary Source="/Theme/ModernUI/Assets/ModernDialog.xaml" />
                <ResourceDictionary Source="/Theme/ModernUI/Assets/ModernMenu.xaml" />
                <ResourceDictionary Source="/Theme/ModernUI/Assets/ModernTab.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:ContentLoader x:Key="CustomContentLoader" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
